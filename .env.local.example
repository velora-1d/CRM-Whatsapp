# ============================================================
# REQUIRED — the app won't start without these.
# ============================================================

# Database Connection (Neon DB or generic PostgreSQL)
# For Neon serverless pooling, use the connection string with pooling.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# If using Prisma/Drizzle migrations, a direct connection string might be needed:
# DIRECT_URL=postgresql://user:password@host/dbname?sslmode=require

# NextAuth (Auth.js v5) Configuration
# Generate a secret with: openssl rand -hex 32
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# WhatsApp Provider Configuration
# Set default provider: 'meta' or 'evolution'
NEXT_PUBLIC_DEFAULT_WA_PROVIDER=meta

# -----------------
# 1. Meta Cloud API Credentials (Required if using Meta)
# -----------------
# Supabase Url & Anon Key (only if still using any Supabase services/storage)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Meta App Secret (Meta for Developers → App Settings → Basic)
META_APP_SECRET=your-meta-app-secret

# -----------------
# 2. Evolution API Credentials (Required if using Evolution)
# -----------------
EVOLUTION_API_URL=https://your-evolution-instance-url.com
EVOLUTION_API_TOKEN=your-global-evolution-api-token

# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used to encrypt sensitive instance tokens stored in the database.
ENCRYPTION_KEY=your-64-char-hex-key-here

# ============================================================
# RECOMMENDED — safe defaults exist but you'll want to set these.
# ============================================================

# Canonical public URL of this deployment
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Real-time synchronization provider: 'sse' (Server-Sent Events) or 'pusher'
REALTIME_PROVIDER=sse

# Pusher Credentials (only required if REALTIME_PROVIDER=pusher)
# PUSHER_APP_ID=your-pusher-app-id
# PUSHER_KEY=your-pusher-key
# PUSHER_SECRET=your-pusher-secret
# PUSHER_CLUSTER=your-pusher-cluster
# NEXT_PUBLIC_PUSHER_KEY=your-pusher-key
# NEXT_PUBLIC_PUSHER_CLUSTER=your-pusher-cluster

# ============================================================
# OPTIONAL — only needed if you use the feature.
# ============================================================

# Shared secret protecting GET /api/automations/cron.
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

